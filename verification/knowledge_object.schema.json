{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maya:verification:knowledge-object:1",
  "title": "Canonical knowledge object — envelope schema (MAYA Batch #2)",
  "description": "Declarative contract mirror of maya_runtime/intelligence/canonical.py envelope construction. The runtime enforces the same contracts through representation.py; no external validator library is available on any interpreter, so external JSON-Schema validation is recorded as UNAVAILABLE — NOT VALIDATED. Independent agreement between this schema and the runtime contracts is witnessed by verification/oracle_representation.py.",
  "type": "object",
  "required": [
    "protocol",
    "protocol_version",
    "schema",
    "object_id",
    "record_type",
    "schema_version",
    "created_at",
    "provenance",
    "metadata",
    "body",
    "integrity"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "maya.knowledge_object"
    },
    "protocol_version": {
      "const": 1
    },
    "schema": {
      "const": "maya:knowledge-object:1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=-]{0,127}$"
    },
    "record_type": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=-]{0,127}$"
    },
    "schema_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "provenance": {
      "type": "object",
      "required": ["source", "retrieved_at", "evidence_type", "confidence"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "pattern": "^(https?://.*|)$"
        },
        "retrieved_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "published_at": {
          "type": "string",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})|)$"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "fact",
            "report",
            "observation",
            "historical_record",
            "user_approved_context"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "claim": {
          "type": "string"
        },
        "perspective": {
          "type": "string"
        },
        "uncertainty": {
          "type": "string"
        }
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=-]{0,127}$"
      },
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          { "type": "number" },
          { "type": "boolean" },
          { "type": "null" }
        ]
      }
    },
    "body": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/=-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "identifier", "text", "scalar", "measurement", "vector",
              "matrix", "symbol", "equation", "category", "relation",
              "event", "temporal_interval", "geometric_point",
              "geometric_vector", "geometric_transform", "geometric_object",
              "graph", "probability", "confidence", "uncertainty",
              "provenance", "metadata"
            ]
          },
          "value": {
            "description": "Contractually constrained by representation.py; declaratively opaque here so the runtime remains the enforcement point."
          },
          "units": { "type": "string" },
          "dim": { "type": "integer", "minimum": 1 },
          "rows": { "type": "integer", "minimum": 1 },
          "cols": { "type": "integer", "minimum": 1 },
          "precision": { "type": "integer", "minimum": 1 },
          "language": { "type": "string" },
          "code_set": {
            "type": "array",
            "items": { "type": "string" }
          },
          "predicates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "nodes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "event_types": {
            "type": "array",
            "items": { "type": "string" }
          },
          "geometry_kind": {
            "type": "string",
            "enum": ["point", "curve", "surface", "mesh"]
          },
          "kind": {
            "type": "string",
            "enum": ["translate", "rotate", "scale", "reflect", "compose"]
          },
          "space": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "tolerance": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["alg", "source", "digest", "bytes"],
      "additionalProperties": false,
      "properties": {
        "alg": {
          "const": "sha-256"
        },
        "source": {
          "const": "jcs-rfc-8785"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}