{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maya.identity.profiles/schemas/persona_training.schema.json",
  "title": "Maya Persona Training Set",
  "description": "Curated, deterministic tuning sets per job persona. Consumed as registry bundles by the persona layer — never as model weights. Every ceiling must fit CHANNEL_MAX; every tone/vocabulary id must exist in the registries.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "personas"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "personas": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/personaEntry" }
    }
  },
  "$defs": {
    "basePersona": {
      "type": "string",
      "enum": ["authoritative", "calm", "playful", "warm"]
    },
    "toneId": {
      "type": "string",
      "enum": ["authoritative", "even", "lively", "soothing", "technical", "warm"]
    },
    "vocabularyId": {
      "type": "string",
      "enum": [
        "assistive_base",
        "business_clear",
        "entertainment_playful",
        "technical_precise",
        "therapeutic_gentle"
      ]
    },
    "emotionalCeiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "viseme", "micro", "anatomical"],
      "properties": {
        "expression": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "viseme": { "type": "number", "minimum": 0, "maximum": 0.35 },
        "micro": { "type": "number", "minimum": 0, "maximum": 0.012 },
        "anatomical": { "type": "number", "minimum": 0, "maximum": 0.8 }
      }
    },
    "toneExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tone", "example"],
      "properties": {
        "tone": { "$ref": "#/$defs/toneId" },
        "example": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "vocabList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "items"],
      "properties": {
        "register": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-z][a-z0-9_]*$" },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 2, "maxLength": 48 }
        }
      }
    },
    "behaviorSample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "behavior"],
      "properties": {
        "input": { "type": "string", "minLength": 1, "maxLength": 240 },
        "behavior": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "directiveRef": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9_ :.-]*$"
    },
    "personaEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id",
        "display_name",
        "base_persona",
        "tone_default",
        "vocabulary_set",
        "emotional_ceiling",
        "tone_examples",
        "vocabulary_lists",
        "behavioral_samples",
        "allowed_expressions",
        "forbidden_expressions",
        "role_directives"
      ],
      "properties": {
        "persona_id": {
          "type": "string",
          "enum": ["companion", "concierge", "kiosk_assistant", "receptionist", "sales_agent", "tutor"]
        },
        "display_name": { "type": "string", "minLength": 2, "maxLength": 60 },
        "domain": {
          "type": "string",
          "enum": ["customer_service", "entertainment", "robotics_interface", "therapy_support", "tutoring"]
        },
        "base_persona": { "$ref": "#/$defs/basePersona" },
        "tone_default": { "$ref": "#/$defs/toneId" },
        "vocabulary_set": { "$ref": "#/$defs/vocabularyId" },
        "emotional_ceiling": { "$ref": "#/$defs/emotionalCeiling" },
        "tone_examples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/toneExample" }
        },
        "vocabulary_lists": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/vocabList" }
        },
        "behavioral_samples": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/behaviorSample" }
        },
        "allowed_expressions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "forbidden_expressions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "role_directives": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "items": { "$ref": "#/$defs/directiveRef" }
        }
      }
    }
  }
}