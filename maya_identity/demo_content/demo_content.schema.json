{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maya.identity.profiles/schemas/demo_content.schema.json",
  "title": "Maya Demo Content Layer",
  "description": "Structured, persona-aligned demo content: greeting flows, example Q&A, demo lines, persona-safe humor, fallback responses. All entries are tone/register/persona tagged and deterministic (key-selected, never random).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "package_name", "greetings", "qa", "demo_lines", "humor", "fallbacks"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "package_name": { "type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$" },
    "greetings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/greetingFlow" }
    },
    "qa": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/qaPair" }
    },
    "demo_lines": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": { "$ref": "#/$defs/personaId" },
      "properties": {
        "receptionist": { "type": "array", "items": { "$ref": "#/$defs/lineItem" } },
        "companion": { "type": "array", "items": { "$ref": "#/$defs/lineItem" } },
        "tutor": { "type": "array", "items": { "$ref": "#/$defs/lineItem" } }
      }
    },
    "humor": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/humorItem" }
    },
    "fallbacks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fallbackItem" }
    }
  },
  "$defs": {
    "personaId": {
      "type": "string",
      "enum": ["companion", "concierge", "kiosk_assistant", "receptionist", "sales_agent", "tutor"]
    },
    "toneId": {
      "type": "string",
      "enum": ["authoritative", "even", "lively", "soothing", "technical", "warm"]
    },
    "registerId": {
      "type": "string",
      "enum": [
        "assurance", "banter", "celebration", "clarify", "fallback", "greeting",
        "hint", "humor", "instruction", "intent", "options", "policy", "progress",
        "reassurance", "restorative", "soothing", "status", "step", "transfer", "wait"
      ]
    },
    "flowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "register": { "$ref": "#/$defs/registerId" },
        "tone": { "$ref": "#/$defs/toneId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "greetingFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "persona_id", "register", "tone", "flow"],
      "properties": {
        "key": { "type": "string", "minLength": 2, "maxLength": 64 },
        "persona_id": { "$ref": "#/$defs/personaId" },
        "register": { "$ref": "#/$defs/registerId" },
        "tone": { "$ref": "#/$defs/toneId" },
        "flow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/flowStep" }
        }
      }
    },
    "qaPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "persona_id", "intent", "tone", "question", "answer"],
      "properties": {
        "key": { "type": "string", "minLength": 2, "maxLength": 64 },
        "persona_id": { "$ref": "#/$defs/personaId" },
        "intent": { "type": "string", "minLength": 2, "maxLength": 64 },
        "tone": { "$ref": "#/$defs/toneId" },
        "question": { "type": "string", "minLength": 1, "maxLength": 200 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "lineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "register", "tone", "text"],
      "properties": {
        "key": { "type": "string", "minLength": 2, "maxLength": 64 },
        "register": { "$ref": "#/$defs/registerId" },
        "tone": { "$ref": "#/$defs/toneId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "humorItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "register", "tone", "text"],
      "properties": {
        "key": { "type": "string", "minLength": 2, "maxLength": 64 },
        "register": {
          "type": "string",
          "enum": ["gentle", "safe", "warm", "wit"]
        },
        "tone": { "type": "string", "enum": ["even", "lively", "warm"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "fallbackItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "channel", "tone", "text"],
      "properties": {
        "key": { "type": "string", "minLength": 2, "maxLength": 64 },
        "channel": {
          "type": "string",
          "enum": ["cannot_help", "clarify", "neutral", "unknown", "urgent"]
        },
        "tone": { "$ref": "#/$defs/toneId" },
        "persona_id": { "$ref": "#/$defs/personaId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}